/sentry  https://github.com/HariEshwar-J-A/info-sentry  301
/sentry/*  https://github.com/HariEshwar-J-A/info-sentry  301

# Missing /assets/* must 404 as plain text — never rewrite to index.html.
# Otherwise stale tabs fetch deleted chunk URLs, get HTML, and crash with
# "Failed to fetch dynamically imported module".
/assets/*  /asset-missing.txt  404

/api/ops  /.netlify/functions/ops  200

# SPA fallback for client routes (/ai, /3d, …).
# Hat paths are appended at build time by scripts/prerender-hats.mjs:
# /<hat>/ 301s to /<hat>, and /<hat> rewrites to /<hat>.html.
/api/health   /.netlify/functions/health   200
/api/contact  /.netlify/functions/contact  200
/* /index.html  200
