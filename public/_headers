# Hashed build assets — long-cache; missing files must NOT fall through to the SPA HTML rewrite.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# nosniff is the same value the astrology app sends, so it can stay site-wide.
# CSP and X-Frame-Options are portfolio documents only. /astrology keeps the upstream headers.
# The app sends x-robots-tag: noindex. These rules replace that with a single indexable value.
/*
  X-Content-Type-Options: nosniff

/astrology
  X-Robots-Tag: all

/astrology/*
  X-Robots-Tag: all

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.emailjs.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://cdn.plot.ly; worker-src 'self' blob:; frame-src https://harieshwar-ai.github.io https://trackmyhabit.netlify.app; media-src 'self' blob:; form-action 'self'

